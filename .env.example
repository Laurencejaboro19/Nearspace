# onepot CORE search + ordering. Without this, Nearspace searches Enamine only.
# Request a key from onepot.ai (ask for academic access).
ONEPOT_API_KEY=

# Optional. Enamine REAL database name on sw.docking.org. Leave blank to
# auto-detect the newest REAL space at runtime.
SMALLWORLD_DB=

# Optional but strongly recommended before you make the site public: a Vercel KV
# store so vendor searches are cached across function instances instead of being
# re-run against UCSF's server for every visitor.
KV_REST_API_URL=
KV_REST_API_TOKEN=
